# ── LLM Providers ────────────────────────────────────────────────────
# Primary: Google Gemini (free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback: Groq (free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── Reporting (draft by default; set AUTO_REPORT=send to email) ─────
AUTO_REPORT=draft
REPORT_MIN_SCORE=0.8
REPORT_TEST_MODE=true
REPORT_MAX_PER_HOUR=5
REPORT_RECIPIENTS=incident@cert-in.org.in,reportphishing@apwg.org
REPORT_COPY_TO_SELF=you@example.com
# Verify each address on the official website before real use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Complainant details for the report header. These should be truthful for
# any real complaint; dummy values are okay for testing only.
COMPLAINANT_NAME=Jane Doe
COMPLAINANT_PHONE=+91 98765 43210
COMPLAINANT_EMAIL=jane.doe@example.com

# ── MongoDB (optional) ────────────────────────────────────────────────
# Set USE_DB=false to run fully in-memory (intel logs saved as JSON files)
USE_DB=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agentic_honeypot
